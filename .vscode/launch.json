{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug orx (from source)",
      "type": "bun",
      "request": "launch",
      "program": "src/bin.ts",
      "args": ["ask", "hello"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug current bun test file",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["test"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
