# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# bun loads it for everything run from this checkout (bun run orx, tui:capture, eval,
# record:openrouter). The compiled binary never reads a .env; installed orx uses your shell's
# env and ~/.config/orx/config.json (docs/reference.md, Configuration).

# OpenRouter. Commands that call a model exit 3 while the key is empty.
OPENROUTER_API_KEY=
# Default model id, used when --model isn't given. Any model with tool support works (the
# picker lists them). These three passed the rename-across-files coding eval for under a cent
# each (docs/rfcs/RFC001-bootstrap-agent-harness/phase-1-edits-code.md). The first is also the
# built-in default (FALLBACK_DEFAULT_MODEL in src/config.ts), used when this is empty.
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# System prompt override; empty uses the default in src/config.ts.
SYSTEM_PROMPT=

# Routing (all optional). Comma-separated fallback model ids, tried in order when the main
# model fails.
OPENROUTER_FALLBACK_MODELS=openai/gpt-6-luna,deepseek/deepseek-v4-flash
# Provider sort: price, throughput, or latency. Empty lets OpenRouter decide.
OPENROUTER_PROVIDER_SORT=
OPENROUTER_ALLOW_FALLBACKS=true
# allow or deny. deny only routes to providers that don't store prompts.
OPENROUTER_DATA_COLLECTION=allow
# true routes only to zero-data-retention endpoints.
OPENROUTER_ZDR=false
# API base URL. Leave empty for https://openrouter.ai/api/v1 (`bun run stub` prints a local one).
# OPENROUTER_BASE_URL=

# Limits
# Reply length cap, model steps per turn (each step can call tools), and how many seconds a
# reply may go without a chunk from the model (time spent running tools doesn't count).
MAX_OUTPUT_TOKENS=8192
MAX_TOOL_STEPS=50
MAX_STREAM_SECONDS=120

# Logging, all on stderr (stdout carries only results). Level: debug, info, warn (the binary's
# default), or error; bun run orx defaults to info. Format: pretty or json. ORX_LOG_FILE also
# appends JSON lines to a file (bun run orx sets logs/orx.jsonl).
LOG_LEVEL=
ORX_LOG_FORMAT=
# ORX_LOG_FILE=

# Where chats are saved. Default ~/.local/share/orx ($XDG_DATA_HOME/orx); bun run orx uses .orx/data.
# ORX_DATA_DIR=

# Self-update source (orx update, install.sh). Tests and `bun run stub` point these at a stub.
# ORX_RELEASES_REPO=rileyhilliard/orx
# ORX_RELEASES_URL=https://api.github.com
